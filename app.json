{
  "expo": {
    "name": "Heartura",
    "slug": "heartura",
    "owner": "heartura-technologies-llc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homecare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.heartura",
      "appleTeamId": "39HKKMB693"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.heartura",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF4F2",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111214",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can share them in messages.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can share photos in messages.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "largeIcon": "./assets/images/icon.png",
          "color": "#1A5AA6",
          "defaultChannel": "default",
          "enableRemoteNotifications": false
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8cbae2f9-3878-4c2a-980e-97f7d1721bc0"
      }
    }
  }
}
